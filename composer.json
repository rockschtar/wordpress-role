{
  "name": "rockschtar/wordpress-role",
  "description": "WordPress Role Abstraction",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Stefan Helmer",
      "email": "rockschtar@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "3.* || 4.*",
    "phpunit/phpunit": "^11",
    "brain/monkey": "^2"
  },
  "autoload": {
    "psr-4": {
      "Rockschtar\\WordPress\\Role\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rockschtar\\WordPress\\Role\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs": "phpcs"
  }
}
